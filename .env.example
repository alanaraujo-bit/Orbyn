# ---------------------------------------------------------------------------
# Orbyn - local environment
# Copy to `.env` and fill in. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- OpenAI -----------------------------------------------------------------
# Leave OPENAI_API_KEY empty to run the system with the AI engine disabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.1
OPENAI_MODEL_FAST=gpt-5.1-mini
OPENAI_MONTHLY_BUDGET_USD=25
# Preco por 1 milhao de tokens, conforme o seu plano. Deixe vazio se nao souber:
# o sistema registra a chamada e marca o custo como nao calculado.
# "CACHED_INPUT" cobre os tokens de entrada servidos pelo cache de prompt.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_CACHED_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=
OPENAI_FAST_PRICE_INPUT_PER_1M=
OPENAI_FAST_PRICE_CACHED_INPUT_PER_1M=
OPENAI_FAST_PRICE_OUTPUT_PER_1M=

# --- Chrome (browser outreach over CDP) -------------------------------------
# Bind the debugging port to loopback only. Never 0.0.0.0.
CHROME_CDP_URL=http://127.0.0.1:9222
CHROME_PROFILE_DIR=./.chrome-profile

# --- Instagram / Meta official API ------------------------------------------
INSTAGRAM_APP_SECRET=
INSTAGRAM_PAGE_ACCESS_TOKEN=
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Endereço público que a Meta usa para entregar os webhooks, incluindo o caminho
# /api/webhooks/instagram. Preenchido automaticamente por `pnpm tunnel`.
# Com ele configurado, o worker verifica a cada 5 minutos se esse endereço ainda
# chega até esta máquina e abre alerta crítico quando parar de chegar.
PUBLIC_WEBHOOK_URL=

# --- Storage ----------------------------------------------------------------
DATABASE_URL=file:./data/orbyn.db
BACKUP_DIR=./backups
ARTIFACTS_DIR=./screenshots

# --- Operational guardrails (ceilings, not targets) -------------------------
MAX_DMS_PER_DAY=30
MIN_SECONDS_BETWEEN_DMS=90
MAX_SECONDS_BETWEEN_DMS=240
OPERATING_HOURS=09:00-20:00
OPERATING_TIMEZONE=America/Belem

# --- Runtime ----------------------------------------------------------------
WEB_PORT=4310
LOG_LEVEL=info
WORKER_POLL_INTERVAL_MS=2000
DATA_RETENTION_DAYS=365

# Real DM smoke test is refused unless this is exactly `true` AND the operator
# passes --i-authorize-real-dm on the command line.
ALLOW_REAL_DM_SMOKE_TEST=false
